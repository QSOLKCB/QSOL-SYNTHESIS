digraph ThemeNetwork {
  rankdir=LR;
  node [shape=ellipse];
  observation -> falsification;
  representation -> interpretation;
  representation -> visualisation;
  simulation -> nonclaims;
  formal_verification -> nonclaims;
  recovery -> preservation;
  provenance -> replay;
  external_state -> semantic_transport;
  authority_partitioning -> evidence_promotion;
  oracle_candidate_parity -> recovery;
  sonification -> representation;
  minimal_sufficient_systems -> preservation;
  representation -> observation;
}
